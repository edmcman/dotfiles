#!/usr/bin/env bash

function claude-bedrock() {
	source "$DOROTHY/sources/bash.bash"

	if [[ ! ${1-} =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
		printf 'Usage: claude-bedrock <token-prefix> [claude arguments...]\n' >&2
		return 1
	fi
	local token_variable="${1}_AWS_BEARER_TOKEN_BEDROCK"
	shift
	if [[ -z ${!token_variable:-} ]]; then
		printf 'Missing bearer token: %s\n' "$token_variable" >&2
		return 1
	fi

	AWS_REGION="${AWS_REGION:-us-east-1}" \
	ANTHROPIC_DEFAULT_FABLE_MODEL=us.anthropic.claude-fable-5 \
	ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-5-5 \
	ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-5-5 \
	ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-5-5 \
	CLAUDE_CODE_USE_BEDROCK=1 \
	CLAUDE_CODE_USE_MANTLE=1 \
	AWS_BEARER_TOKEN_BEDROCK="${!token_variable}" \
		claude "$@"
}

# fire if invoked standalone
if test "$0" = "${BASH_SOURCE[0]}"; then
	claude-bedrock "$@"
fi
