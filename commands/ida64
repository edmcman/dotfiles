#!/usr/bin/env bash

function ida64() {
    source "$DOROTHY/sources/bash.bash"

    local IDADIR="/opt/idapro"
    local VERSION="${IDA_VERSION:-$(ls "$IDADIR" | sort -V | tail -n1)}"

    # 9.0 merged ida64 into ida; before that, ida is the 32-bit build
    local BIN="$IDADIR/$VERSION/ida64"
    test -x "$BIN" || BIN="$IDADIR/$VERSION/ida"

    "$BIN" "$@"
}

# fire if invoked standalone
if test "$0" = "${BASH_SOURCE[0]}"; then
	ida64 "$@"
fi